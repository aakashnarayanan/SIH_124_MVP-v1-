# Normalize line endings: LF in repo, OS-native on checkout
* text=auto

# Python — always LF
*.py text eol=lf

# Shell scripts — always LF
*.sh text eol=lf
*.bash text eol=lf

# Windows batch files — always CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Web / Config
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.proto text eol=lf
*.csv text eol=lf

# Binary files — do not touch line endings
*.mp4 binary
*.avi binary
*.mov binary
*.pt binary
*.dll binary
*.db binary
*.sqlite binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
