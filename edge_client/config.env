# ============================================================
#  SURADAK Edge Client — Configuration
#  Edit the two marked lines, then double-click start.bat
# ============================================================

# ★ EDIT THIS: IP address of the server laptop
#   On Windows: run `ipconfig` and find your WiFi/hotspot IPv4 address
SERVER_IP=192.168.1.100

# ★ EDIT THIS: Your unique bus ID — every client must be different!
#   e.g.  bus_2  bus_3  bus_4  bus_5
BUS_ID=bus_2

# GPS route file inside gps_tracks/ — pick one per client
#   route_1 = Connaught Place circular
#   route_2 = India Gate → Khan Market
#   route_3 = Karol Bagh loop
#   route_4 = Saket → Hauz Khas
#   route_5 = Lajpat Nagar → Nehru Place
ROUTE=route_2

# Path to the dashcam video file (place it in assets/ and update this)
VIDEO=assets/dashcam.mp4

# Stream annotated JPEG frames to the dashboard video tab? (true = demo mode)
DEMO_STREAM_FRAMES=true

# MQTT broker port — leave as 1883 unless your server changed it
BROKER_PORT=1883

# Inference frames-per-second (10–15 recommended; lower = less CPU load)
FPS=10

# Show live OpenCV window on this client machine? (true/false)
SHOW_VIDEO=false
